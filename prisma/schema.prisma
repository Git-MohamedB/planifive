datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ==========================================
// 2. Modèles pour l'Authentification (NextAuth)
// ==========================================

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?
  access_token       String?
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?   // Avatar Discord/Google
  customName    String?   // Prénom personnalisé défini par l'admin
  isBanned      Boolean   @default(false)
  accentColor   String?   @default("#22C55E")
  skillLevel    Int?      @default(5) // 1-10 level for balanced team generation
  technique     Float?    // Niveau technique/foot (0-5)
  cardio        Float?    // Cardio/Intensité (0-5)

  accounts      Account[]
  sessions      Session[]

  // Nos relations personnalisées pour le Five
  availabilities Availability[]
  templates      AvailabilityTemplate[]

  matchesTeam1 Match[] @relation("Team1")
  matchesTeam2 Match[] @relation("Team2")
  
  calls        Call[]
  callResponses CallResponse[]
  comments     SlotComment[]
  notifications Notification[]
}

model Match {
  id        String   @id @default(cuid())
  date      DateTime
  location  String?
  scoreTeam1 Int     @default(0)
  scoreTeam2 Int     @default(0)

  // Noms des joueurs personnalisés (JSON)
  team1Names String?
  team2Names String?

  // Système de votes MVP (JSON map userId -> playerName)
  mvpVotes   String?
  mvpWinner  String?

  team1     User[]   @relation("Team1")
  team2     User[]   @relation("Team2")

  createdAt DateTime @default(now())
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ==========================================
// 3. Modèles pour le Planifive
// ==========================================

// Les disponibilités réelles (Liées à une date spécifique)
model Availability {
  id        String   @id @default(cuid())
  userId    String

  // On stocke la date sous format DateTime
  date      DateTime

  // On stocke l'heure (8 à 23)
  hour      Int

  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Index pour rendre les recherches ultra rapides
  @@index([date, hour])
  @@unique([userId, date, hour])
}

// La "Semaine Type" (Pour la duplication intelligente)
model AvailabilityTemplate {
  id        String   @id @default(cuid())
  userId    String

  // 0 = Dimanche, 1 = Lundi, ..., 6 = Samedi
  dayOfWeek Int

  hour      Int

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Un user ne peut pas avoir deux templates pour le même créneau
  @@unique([userId, dayOfWeek, hour])
}

// ==========================================
// 4. Modèles pour l'intégration Discord / Call
// ==========================================

model Call {
  id        String   @id @default(cuid())
  creatorId String
  date      DateTime
  hour      Int
  location  String
  duration  Int      @default(60) // 60 or 90 minutes
  price     String?  // Optional price (e.g. "10€")
  comment   String?  // Optional comment
  discordMessageId String? // ID du message Discord pour les mises à jour
  createdAt DateTime @default(now())

  creator   User     @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  responses CallResponse[]
}

model CallResponse {
  id        String   @id @default(cuid())
  callId    String
  userId    String
  status    String   // "ACCEPTED" or "DECLINED"
  createdAt DateTime @default(now())

  call      Call     @relation(fields: [callId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([callId, userId])
}

model SlotStatus {
  id           String   @id @default(cuid())
  date         DateTime
  hour         Int
  isFullNotified Boolean @default(false)
  isGoldenNotified Boolean @default(false)

  @@unique([date, hour])
}

// ==========================================
// 5. Commentaires et Réactions sur les créneaux
// ==========================================

model SlotComment {
  id        String   @id @default(cuid())
  userId    String
  date      DateTime
  hour      Int
  type      String   @default("COMMENT") // "CERTAIN", "MAYBE", "COMMENT"
  message   String?  // Texte pour le commentaire
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([date, hour])
}

// ==========================================
// 6. Notifications In-App
// ==========================================

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String   // "SLOT_FULL", "CALL_CREATED", "MATCH_RECORDED", "DISPO_REMINDER"
  title     String
  message   String
  link      String?  // URL de redirection au clic
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
}

// ==========================================
// 7. Notations Communautaires des Cartes FUT
// ==========================================

model FUTCardRating {
  id           String   @id @default(cuid())
  targetUserId String   // ID ou nom du joueur noté (ex: David)
  voterUserId  String   // ID du joueur votant
  voterName    String?  // Nom du votant

  pac          Int      @default(75) // Vitesse / Rythme
  sho          Int      @default(75) // Frappe / Finition
  pas          Int      @default(75) // Passe / Vision
  dri          Int      @default(75) // Dribble / Technique
  def          Int      @default(75) // Défense / Solidité
  phy          Int      @default(75) // Physique / Cardio

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([targetUserId, voterUserId])
  @@index([targetUserId])
}